# ==============================================================================
# CampusOS Production Environment Configuration
# ==============================================================================

# In production, DEBUG MUST be false. Insecure default secrets will cause startup rejection.
ENVIRONMENT=production
PROJECT_NAME="CampusOS Enterprise ERP"
VERSION="0.1.0"
DEBUG=false
API_V1_STR="/api/v1"

# Production Managed PostgreSQL (e.g. AWS RDS Multi-AZ / Azure Flexible Server / Supabase Enterprise)
# Format: postgresql+asyncpg://<username>:<password>@<host>:5432/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://campusos_prod_user:CHANGE_ME_PRODUCTION_DB_PASSWORD@prod-db.campusos.internal:5432/campusos_production?ssl=require
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Production Redis Cluster (Auth & TLS)
REDIS_URL=rediss://:CHANGE_ME_PRODUCTION_REDIS_PASSWORD@prod-redis.campusos.internal:6379/0

# Production Cryptographic Secrets (MUST be at least 32 characters, preferably 64 hex chars)
# Generate with: `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_TO_CRYPTOGRAPHICALLY_SECURE_PRODUCTION_SECRET_KEY_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Cookies & Transport Security
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true

# Production Explicit CORS (NO WILDCARDS ALLOWED)
CORS_ORIGINS=["https://campusos.edu","https://app.campusos.edu"]

# Production Object Storage (AWS S3 / Cloudflare R2 / GCS)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=s3.ap-south-1.amazonaws.com
STORAGE_ACCESS_KEY=PRODUCTION_AWS_ACCESS_KEY_ID
STORAGE_SECRET_KEY=PRODUCTION_AWS_SECRET_ACCESS_KEY
STORAGE_BUCKET_NAME=campusos-production-documents
STORAGE_REGION=ap-south-1
STORAGE_USE_SSL=true

# Production Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_BURST_MAX=30

# Production Payload Size Bounds (Bytes)
MAX_JSON_BODY_BYTES=2097152
MAX_MULTIPART_BYTES=26214400

# AI & Intelligence Engine Production Settings
AI_PROVIDER=mock
AI_MODEL=campusos-institutional-v1
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_RATE_LIMIT_PER_MINUTE_USER=60
AI_RATE_LIMIT_PER_MINUTE_TENANT=500
AI_MAX_QUERY_LENGTH=2000
AI_MAX_TOOL_RESULTS=50

# Production Frontend Environment Variables (Injected at build/deploy time)
NEXT_PUBLIC_API_URL=https://api.campusos.edu
NEXT_PUBLIC_APP_NAME="CampusOS"
