# Environment: development | staging | production | test
ENVIRONMENT=development
PROJECT_NAME="CampusOS API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# CORS configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database connection URL (PostgreSQL AsyncPG)
DATABASE_URL=postgresql+asyncpg://campusos_user:campusos_password@localhost:5432/campusos_db

# Security & Secrets (Change to strong secret in production)
SECRET_KEY=campusos_insecure_development_secret_key_minimum_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=campusos_admin
STORAGE_SECRET_KEY=campusos_minio_secret
STORAGE_BUCKET_NAME=campusos-documents
STORAGE_USE_SSL=false

# Performance Engineering & Capacity Planning (Step 32)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_SECONDS=15
POSTGRES_MAX_SYSTEM_CONNECTIONS=100

REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_REFERENCE_DATA_TTL_SECONDS=3600

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_EXPORT_ROWS=10000

TENANT_RATE_LIMIT_PER_MINUTE=1200
TENANT_BURST_LIMIT=200
TENANT_CONCURRENT_REPORTS_LIMIT=3

WORKER_CONCURRENCY=5
OUTBOX_BATCH_SIZE=50
JOB_TIMEOUT_SECONDS=120

HTTP_CLIENT_TIMEOUT_SECONDS=10.0
HTTP_CLIENT_MAX_CONNECTIONS=100
HTTP_CLIENT_MAX_KEEPALIVE=20