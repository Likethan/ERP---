# Environment: development | staging | production | test
ENVIRONMENT=development
PROJECT_NAME="CampusOS API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# CORS configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database connection URL (PostgreSQL AsyncPG)
DATABASE_URL=postgresql+asyncpg://campusos_user:campusos_password@localhost:5432/campusos_db

# Security & Secrets (Change to strong secret in production)
SECRET_KEY=campusos_insecure_development_secret_key_minimum_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=campusos_admin
STORAGE_SECRET_KEY=campusos_minio_secret
STORAGE_BUCKET_NAME=campusos-documents
STORAGE_USE_SSL=false
