# ==============================================================================
# CampusOS Staging Environment Configuration
# ==============================================================================

ENVIRONMENT=staging
PROJECT_NAME="CampusOS API (Staging)"
VERSION="0.1.0"
DEBUG=false
API_V1_STR="/api/v1"

# Managed PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://staging_user:CHANGE_ME_STAGING_PASSWORD@staging-db.campusos.internal:5432/campusos_staging
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache Cluster with Auth
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@staging-redis.campusos.internal:6379/0

# Security (Strong secrets required)
SECRET_KEY=GENERATE_STAGING_SECRET_KEY_MINIMUM_32_CHARS_LONG_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true

# Explicit Staging CORS
CORS_ORIGINS=["https://staging.campusos.edu","https://staging-app.campusos.edu"]

# Object Storage (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=s3.ap-south-1.amazonaws.com
STORAGE_ACCESS_KEY=STAGING_AWS_ACCESS_KEY_ID
STORAGE_SECRET_KEY=STAGING_AWS_SECRET_ACCESS_KEY
STORAGE_BUCKET_NAME=campusos-staging-documents
STORAGE_REGION=ap-south-1
STORAGE_USE_SSL=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# AI Provider
AI_PROVIDER=mock
AI_MODEL=campusos-institutional-v1

# Frontend
NEXT_PUBLIC_API_URL=https://staging-api.campusos.edu
NEXT_PUBLIC_APP_NAME="CampusOS (Staging)"
