# ==============================================================================
# CampusOS Monorepo Environment Configuration Template
# One Campus. One System. One Source of Truth.
# ==============================================================================

# Core Application Environment: development | staging | production | test
ENVIRONMENT=development
PROJECT_NAME="CampusOS Enterprise ERP"
VERSION="0.1.0"
DEBUG=false
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=campusos_user
POSTGRES_PASSWORD=campusos_password
POSTGRES_DB=campusos_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# AsyncPG URL consumed by FastAPI Backend
DATABASE_URL=postgresql+asyncpg://campusos_user:campusos_password@localhost:5432/campusos_db

# Connection Pool Parameters
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Redis Cache, Rate Limiting & Queue
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Cryptography, Tokens & Sessions
# ------------------------------------------------------------------------------
# CRITICAL: In production, generate a secure random 64-char hex key: `openssl rand -hex 32`
SECRET_KEY=campusos_insecure_development_secret_key_minimum_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie & Header Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false

# ------------------------------------------------------------------------------
# CORS Allowed Origins (JSON Array)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# S3 / MinIO Object Storage
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=campusos_admin
STORAGE_SECRET_KEY=campusos_minio_secret
STORAGE_BUCKET_NAME=campusos-documents
STORAGE_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Rate Limiting & Request Bounds
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_BURST_MAX=30
MAX_JSON_BODY_BYTES=2097152
MAX_MULTIPART_BYTES=26214400

# ------------------------------------------------------------------------------
# AI & Intelligence Engine
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_MODEL=campusos-institutional-v1
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_RATE_LIMIT_PER_MINUTE_USER=60
AI_RATE_LIMIT_PER_MINUTE_TENANT=500
AI_MAX_QUERY_LENGTH=2000
AI_MAX_TOOL_RESULTS=50

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="CampusOS"
