# ==============================================================================
# CampusOS Development Environment Configuration
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="CampusOS API (Dev)"
VERSION="0.1.0"
DEBUG=true
API_V1_STR="/api/v1"

# Database (Local Docker or Localhost)
POSTGRES_USER=campusos_user
POSTGRES_PASSWORD=campusos_password
POSTGRES_DB=campusos_db
DATABASE_URL=postgresql+asyncpg://campusos_user:campusos_password@localhost:5432/campusos_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Security (Development placeholder acceptable only in non-production)
SECRET_KEY=campusos_insecure_development_secret_key_minimum_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MinIO Local Storage
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=campusos_admin
STORAGE_SECRET_KEY=campusos_minio_secret
STORAGE_BUCKET_NAME=campusos-documents
STORAGE_USE_SSL=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=30

# AI Provider
AI_PROVIDER=mock
AI_MODEL=campusos-institutional-v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="CampusOS (Dev)"
